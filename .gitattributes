# One rule decides line endings for everything Git considers text.
#
# eol=lf matters as much as text=auto. On its own, text=auto normalizes to LF inside the repository
# but checks out with the platform default, which is CRLF on Windows. That silently broke every
# tracked file without an explicit rule: a fresh clone got CRLF shell scripts, which do not run on
# Linux at all, since "#!/bin/sh" followed by a carriage return is not an interpreter.
#
# Because this covers every path, per-type "text eol=lf" lines are redundant and are not listed.
# Only genuine exceptions appear below.
* text=auto eol=lf

# The one place CRLF is correct: the Windows batch interpreter requires it.
*.bat text eol=crlf
*.cmd text eol=crlf

# Files Git must not treat as text. "binary" is shorthand for "-text -diff": no line-ending
# conversion, and no attempt to show a textual diff.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary

*.otf    binary
*.ttf    binary
*.woff   binary
*.woff2  binary

*.mp3    binary
*.mp4    binary
*.mov    binary
*.wav    binary
*.webm   binary

*.zip    binary
*.tar    binary
*.tar.gz binary
*.tgz    binary
*.7z     binary
*.rar    binary

*.o      binary
*.so     binary
*.a      binary
*.dll    binary
*.dylib  binary
*.rlib   binary
*.rmeta  binary
*.exe    binary
*.out    binary
*.app    binary

*.sqlite binary
*.db     binary

# Diff drivers change how a change is displayed, not how it is stored, so these are unaffected by
# the rule above and still carry their weight: Git uses them to label hunks with the enclosing
# function or section.
*.rs       diff=rust
*.toml     diff=toml
*.json     diff=json
*.ps1      diff=powershell
Cargo.lock diff=rust
