{
  "version": "0.2",

  // Both dialects are accepted. The British spellings in the repository come from CLAUDE.md and
  // docs/brief.md, so rejecting them would mean rewriting the project's own instructions to satisfy
  // a spell checker. Enforcing one dialect is a style decision that cspell handles badly: it can
  // only reject words, not tell which side of the Atlantic a document meant to be on.
  "language": "en,en-GB",

  // Kept to the minimum that makes the repository clean, verified by removing each one and
  // re-running. The "npm" dictionary was dropped even though it was needed: it covered exactly one
  // word, "nvmrc", and brings thousands of package names that could mask a real misspelling.
  // That word is in project-words.txt instead, where it is visible.
  "dictionaries": ["rust", "project-words"],
  "dictionaryDefinitions": [{ "name": "project-words", "path": "./project-words.txt" }],

  "useGitignore": true,
  "ignorePaths": [
    // Generated by npm; full of hashes and package names.
    "package-lock.json",
    // The dictionary itself: spell checking a list of deliberately unusual words is circular.
    "project-words.txt",
  ],

  // Rust string literals contain escape sequences, and without this cspell reads the "\n" at the
  // start of "\nxtask" as part of the word that follows it. Verified: removing this line makes
  // exactly that one false positive reappear, and nothing else changes.
  //
  // The directive below is needed because this comment spells the false positive out, and without
  // it this file reports the very problem it is describing.
  // cspell:ignore nxtask
  "ignoreRegExpList": ["EscapeCharacters"],
}
