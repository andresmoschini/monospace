{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "schedule:weekly",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": ["cargo", "npm", "github-actions", "nvm"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Automerge patch updates after CI passes",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates only on >=1.0.0 dependencies (0.x minors can break)",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": ">=1.0.0",
      "automerge": true
    },
    {
      "description": "Group npm tooling updates",
      "matchManagers": ["npm"],
      "groupName": "npm tooling"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group general Cargo dependency updates",
      "matchManagers": ["cargo"],
      "groupName": "Cargo dependencies"
    },
    {
      "description": "Group ratatui and rat-salsa crates together since they exchange types",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^rat-/", "/^ratatui/"],
      "groupName": "ratatui and rat-salsa"
    }
  ]
}
