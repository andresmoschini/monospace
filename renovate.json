{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "schedule:weekly"],
  "enabledManagers": ["cargo", "npm", "github-actions", "nvm"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Automerge minor and patch updates after CI passes",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Group npm tooling updates",
      "matchManagers": ["npm"],
      "groupName": "npm tooling"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group general Cargo dependency updates",
      "matchManagers": ["cargo"],
      "groupName": "Cargo dependencies"
    },
    {
      "description": "Group ratatui and rat-salsa crates together since they exchange types",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^rat-/", "/^ratatui/"],
      "groupName": "ratatui and rat-salsa"
    }
  ]
}
